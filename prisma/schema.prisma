generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                       String       @id @default(cuid())
  email                                    String       @unique
  passwordHash                             String
  name                                     String?
  phone                                    String?
  isActive                                 Boolean      @default(true)
  createdAt                                DateTime     @default(now())
  updatedAt                                DateTime     @updatedAt
  resetToken                               String?
  resetTokenExpires                        DateTime?
  addresses                                Address[]
  AdminEvent_AdminEvent_actorIdToUser      AdminEvent[] @relation("AdminEvent_actorIdToUser")
  AdminEvent_AdminEvent_targetUserIdToUser AdminEvent[] @relation("AdminEvent_targetUserIdToUser")
  carts                                    Cart[]
  orders                                   Order[]
  orderEvents                              OrderEvent[]
  sessions                                 Session[]
  roles                                    UserRole[]
}

model Role {
  id        String     @id @default(cuid())
  name      RoleName   @unique
  createdAt DateTime   @default(now())
  users     UserRole[]
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
}

model Category {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  parentId     String?
  sortOrder    Int                   @default(0)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  parent       Category?             @relation("CategoryToParent", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryToParent")
  translations CategoryTranslation[]
  products     Product[]
}

model Collection {
  id              String                  @id @default(cuid())
  name            String
  slug            String                  @unique
  description     String?
  status          CollectionStatus        @default(UPCOMING)
  saleMode        SaleMode                @default(DROP)
  startsAt        DateTime?
  endsAt          DateTime?
  isVisible       Boolean                 @default(true)
  backorderPolicy BackorderPolicy         @default(DISALLOW)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  translations    CollectionTranslation[]
  media           Media[]
  products        Product[]
}

model Product {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  description     String?
  type            String?
  gender          String?
  sport           String?
  categoryId      String?
  collectionId    String?
  basePriceEur    Int
  isActive        Boolean              @default(true)
  isFeatured      Boolean              @default(false)
  backorderPolicy BackorderPolicy      @default(DISALLOW)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  media           Media[]
  category        Category?            @relation(fields: [categoryId], references: [id])
  collection      Collection?          @relation(fields: [collectionId], references: [id])
  attributes      ProductAttribute[]
  translations    ProductTranslation[]
  variants        Variant[]
}

model Variant {
  id              String          @id @default(cuid())
  productId       String
  sku             String          @unique
  name            String?
  size            String?
  color           String?
  priceEur        Int?
  stock           Int             @default(0)
  isActive        Boolean         @default(true)
  backorderPolicy BackorderPolicy @default(DISALLOW)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  cartItems       CartItem[]
  media           Media[]
  orderItems      OrderItem[]
  product         Product         @relation(fields: [productId], references: [id])
}

model ProductAttribute {
  id        String   @id @default(cuid())
  productId String
  key       String
  value     String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@index([key, value])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     Locale
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, locale])
  @@index([locale])
}

model CollectionTranslation {
  id           String     @id @default(cuid())
  collectionId String
  locale       Locale
  name         String
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  collection   Collection @relation(fields: [collectionId], references: [id])

  @@unique([collectionId, locale])
  @@index([locale])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  locale      Locale
  name        String
  description String?
  type        String?
  gender      String?
  sport       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])

  @@unique([productId, locale])
  @@index([locale])
}

model Media {
  id           String      @id @default(cuid())
  productId    String?
  variantId    String?
  collectionId String?
  bucket       String
  objectKey    String
  mimeType     String?
  width        Int?
  height       Int?
  alt          String?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  collection   Collection? @relation(fields: [collectionId], references: [id])
  product      Product?    @relation(fields: [productId], references: [id])
  variant      Variant?    @relation(fields: [variantId], references: [id])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String?    @unique
  currency  Currency   @default(EUR)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  variantId    String
  quantity     Int
  unitPriceEur Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cart         Cart     @relation(fields: [cartId], references: [id])
  variant      Variant  @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           PromoType
  value          Int
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  timesRedeemed  Int       @default(0)
  minSubtotalEur Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  userId            String?
  email             String
  phone             String?
  status            OrderStatus    @default(PENDING)
  currency          Currency
  fxRate            Decimal?       @db.Decimal(12, 6)
  subtotalEur       Int
  discountEur       Int            @default(0)
  shippingEur       Int            @default(0)
  totalEur          Int
  totalMinor        Int
  promoCodeId       String?
  shippingAddressId String?
  shippingMethod    ShippingMethod
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  promoCode         PromoCode?     @relation(fields: [promoCodeId], references: [id])
  shippingAddress   Address?       @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  user              User?          @relation(fields: [userId], references: [id])
  events            OrderEvent[]
  items             OrderItem[]
  payments          Payment[]
  shipments         Shipment[]
}

model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  type        OrderEventType
  message     String
  metadata    Json?
  createdById String?
  createdAt   DateTime       @default(now())
  createdBy   User?          @relation(fields: [createdById], references: [id])
  order       Order          @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  variantId    String?
  productName  String
  variantName  String?
  sku          String?
  unitPriceEur Int
  quantity     Int
  totalEur     Int
  attributes   Json?
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id])
  variant      Variant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  amountMinor       Int
  currency          Currency
  providerPaymentId String?
  providerInvoiceId String?
  raw               Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id])
  refunds           Refund[]
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  amountMinor      Int
  status           RefundStatus @default(PENDING)
  reason           String?
  providerRefundId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id])
}

model Shipment {
  id                 String          @id @default(cuid())
  orderId            String
  carrier            ShippingCarrier @default(NOVA_POST)
  method             ShippingMethod
  status             ShipmentStatus  @default(PENDING)
  trackingNumber     String?
  labelUrl           String?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  carrierTrackingUrl String?
  customsDeclaration Json?
  novaPostGlobalRef  String?
  order              Order           @relation(fields: [orderId], references: [id])
}

model Address {
  id                 String   @id @default(cuid())
  userId             String?
  name               String
  phone              String?
  country            String
  region             String?
  city               String
  postalCode         String?
  street1            String
  street2            String?
  novaPostOfficeId   String?
  novaPostOfficeName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  isDefault          Boolean  @default(false)
  countryCode        String?
  validatedAddress   Json?
  validationStatus   String?
  user               User?    @relation(fields: [userId], references: [id])
  shippingOrders     Order[]  @relation("OrderShippingAddress")
}

model FxRate {
  id            String   @id @default(cuid())
  baseCurrency  Currency @default(EUR)
  quoteCurrency Currency
  rate          Decimal  @db.Decimal(18, 8)
  source        String?
  asOf          DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AdminEvent {
  id                                 String         @id @default(cuid())
  actorId                            String
  targetUserId                       String?
  type                               AdminEventType
  metadata                           Json?
  ip                                 String?
  userAgent                          String?
  createdAt                          DateTime       @default(now())
  User_AdminEvent_actorIdToUser      User           @relation("AdminEvent_actorIdToUser", fields: [actorId], references: [id])
  User_AdminEvent_targetUserIdToUser User?          @relation("AdminEvent_targetUserIdToUser", fields: [targetUserId], references: [id])

  @@index([actorId])
  @@index([targetUserId])
  @@index([type])
  @@index([createdAt])
}

enum RoleName {
  ADMIN
  MANAGER
  FULFILLMENT
  SUPPORT
  CUSTOMER
}

enum Currency {
  EUR
  USD
  UAH
}

enum Locale {
  en
  uk
  it
}

enum CollectionStatus {
  UPCOMING
  LIVE
  ENDED
}

enum SaleMode {
  DROP
  ALWAYS_ON
}

enum BackorderPolicy {
  ALLOW
  DISALLOW
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  SHIPPED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  LIQPAY
  MONOBANK
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ShippingCarrier {
  NOVA_POST
  NOVA_POST_GLOBAL
}

enum ShippingMethod {
  NOVA_POST_BRANCH
  NOVA_POST_COURIER
  NOVA_POST_POSTOMAT
  NOVA_POST_GLOBAL_COURIER
  NOVA_POST_GLOBAL_BRANCH
  NOVA_POST_GLOBAL_DOOR
}

enum ShipmentStatus {
  PENDING
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
}

enum PromoType {
  PERCENT
  AMOUNT
  FREE_SHIPPING
}

enum OrderEventType {
  ORDER_CREATED
  STATUS_CHANGE
  SHIPMENT_UPDATE
  REFUND_CREATED
  NOTE
}

enum AdminEventType {
  // User management
  USER_CREATED
  USER_UPDATED
  USER_ROLES_UPDATED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_PASSWORD_RESET_LINK
  USER_INVITE_LINK
  USER_LOGIN
  USER_LOGOUT

  // Product/variant management
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  VARIANT_CREATED
  VARIANT_UPDATED
  VARIANT_DELETED
  VARIANT_STOCK_UPDATED

  // Order management
  ORDER_STATUS_UPDATED
  ORDER_TRACKING_ADDED
  ORDER_NOTE_ADDED
  REFUND_CREATED
  REFUND_UPDATED

  // Content management
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  COLLECTION_CREATED
  COLLECTION_UPDATED
  COLLECTION_DELETED

  // Promo codes
  PROMO_CODE_CREATED
  PROMO_CODE_UPDATED
  PROMO_CODE_DELETED
}
